<Window x:Class="AnyTray.Views.OverlayButtonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        SizeToContent="Manual"
        Focusable="False"
        IsTabStop="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Width="40" Height="30">

    <Window.Resources>
        <!-- Фирменный акцентный градиент (как в логотипе): изумрудный → циановый -->
        <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#10B981" Offset="0" />
            <GradientStop Color="#06B6D4" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AccentHoverBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#34D399" Offset="0" />
            <GradientStop Color="#22D3EE" Offset="1" />
        </LinearGradientBrush>

        <!-- Кнопка «Hide to Tray» в стиле Windows 10/11: БЕЗ заливки — только цветная
             стрелка «в трей». Подсветка-фон появляется лишь при наведении. -->
        <Style x:Key="HideToTrayButtonStyle" TargetType="Button">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="Transparent"
                                CornerRadius="5"
                                Margin="1">
                            <Viewbox Margin="5" Stretch="Uniform">
                                <Path x:Name="Glyph"
                                      Stroke="{StaticResource AccentBrush}"
                                      StrokeThickness="2.2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Data="M8,2.5 L8,9 M8,2.5 L4.5,6 M8,2.5 L11.5,6 M4,13 L12,13" />
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2210B981" />
                                <Setter TargetName="Glyph" Property="Stroke" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#4010B981" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Button x:Name="HideButton"
                Style="{StaticResource HideToTrayButtonStyle}"
                Click="HideButton_Click"
                ToolTip="Свернуть в трей (AnyTray)" />
    </Grid>
</Window>
