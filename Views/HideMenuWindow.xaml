<Window x:Class="AnyTray.Views.HideMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        Opacity="0"
        UseLayoutRounding="True"
        FontSize="13">

    <Window.Resources>
        <!-- Пункт в стиле контекстного меню Windows 11 -->
        <Style x:Key="MenuItemButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1A1E3A8A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#331E3A8A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Внешний Margin оставляет место под тень -->
    <Border Margin="12" Background="#FFFBFBFB" CornerRadius="8"
            BorderBrush="#22000000" BorderThickness="1" Padding="5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.28" Color="Black" />
        </Border.Effect>
        <StackPanel MinWidth="250">
            <TextBlock x:Name="TitleText"
                       Foreground="#FF707070" FontSize="11"
                       Margin="10,4,10,6" TextTrimming="CharacterEllipsis" />

            <Button x:Name="HideButton" Style="{StaticResource MenuItemButton}" Click="HideButton_Click">
                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="16" Height="16" Margin="0,0,10,0">
                        <Path Stroke="#FF1E3A8A" StrokeThickness="1.9"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M5.5,2.5 L5.5,10.5 M5.5,10.5 L2.5,6.5 M5.5,10.5 L8.5,6.5 M10.5,2.5 L10.5,10.5 M10.5,10.5 L7.5,6.5 M10.5,10.5 L13.5,6.5" />
                    </Viewbox>
                    <TextBlock Text="Свернуть в трей" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button x:Name="CancelButton" Style="{StaticResource MenuItemButton}"
                    Click="CancelButton_Click">
                <TextBlock Text="Отмена" Foreground="#FF707070" />
            </Button>
        </StackPanel>
    </Border>
</Window>
