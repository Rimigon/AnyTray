<Window x:Class="AnyTray.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AnyTray — Настройки"
        Icon="pack://application:,,,/Assets/anytray.png"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        FontSize="13">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Автозапуск -->
        <CheckBox Grid.Row="0"
                  Content="Запускать вместе с Windows"
                  IsChecked="{Binding AutostartEnabled}"
                  Margin="0,0,0,14" />

        <!-- Горячая клавиша -->
        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <TextBlock Text="Горячая клавиша скрытия активного окна:" Margin="0,0,0,6" />
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="HotkeyBox"
                         Width="240"
                         IsReadOnly="True"
                         Text="{Binding HotkeyDisplay, Mode=OneWay}"
                         PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                         ToolTip="Кликните и нажмите нужное сочетание (например, Ctrl+Alt+H)" />
                <TextBlock Text="нажмите сочетание…" Foreground="Gray"
                           VerticalAlignment="Center" Margin="10,0,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- Скрытие средним кликом по заголовку -->
        <GroupBox Grid.Row="2" Header="Скрытие средним кликом по заголовку окна" Padding="10" Margin="0,0,0,14">
            <StackPanel>
                <CheckBox Content="Скрывать окно средним кликом (колёсиком) по его заголовку"
                          IsChecked="{Binding MiddleClickEnabled}" Margin="0,0,0,8" />
                <CheckBox Content="Скрывать сразу, без мини-меню"
                          IsChecked="{Binding MiddleClickDirectHide}"
                          IsEnabled="{Binding MiddleClickEnabled}" />
                <TextBlock Text="Работает на всех приложениях (Telegram, VS Code, браузеры). В браузере кликайте по пустой части заголовка, а не по вкладке."
                           Foreground="Gray" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="11" />
            </StackPanel>
        </GroupBox>

        <!-- Кнопки -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сохранить" Width="100" Height="30" Margin="0,0,8,0"
                    IsDefault="True" Command="{Binding SaveCommand}" />
            <Button Content="Отмена" Width="100" Height="30"
                    IsCancel="True" Command="{Binding CancelCommand}" />
        </StackPanel>
    </Grid>
</Window>
